{
	"name": "sveltekit-cf-template",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=24"
	},
	"trustedDependencies": [
		"esbuild",
		"workerd",
		"sharp"
	],
	"overrides": {
		"fast-uri": "^3.1.6",
		"ip-address": "^10.3.1"
	},
	"imports": {
		"#kit-worker": "./.svelte-kit/cloudflare/_worker.js"
	},
	"scripts": {
		"dev": "node scripts/ensure-dev-vars.mjs && vite dev",
		"build": "vite build",
		"preview": "bun run build && wrangler dev --test-scheduled",
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true; (svelte-kit sync && bun run cf-typegen && bun run i18n:compile) || echo ''",
		"check": "bun run cf-typegen && bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:invariants": "node scripts/check-invariants.mjs",
		"check:secrets": "node scripts/check-secrets.mjs",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "bun run build && wrangler deploy",
		"deploy:canary": "bun run build && wrangler versions upload",
		"deploy:promote": "wrangler versions deploy",
		"deploy:rollback": "wrangler rollback",
		"deployments": "wrangler deployments list",
		"upgrade:template": "node scripts/upgrade.mjs",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "node scripts/ensure-dev-vars.mjs && bun run db:migrate && bun run test:unit --run",
		"test:e2e": "playwright test",
		"test:smoke": "playwright test --config=playwright.smoke.config.ts",
		"db:up": "docker compose -f compose.yaml --project-directory .. up -d --wait",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:restore-replay": "node scripts/restore-replay.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.4",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.20.2",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26",
		"@types/qrcode": "^1.5.6",
		"@vitest/browser-playwright": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.8.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.135.0"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.6.23",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.23.0",
		"ai": "^7.0.19",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"creem": "^1.5.3",
		"decimal.js": "^10.6.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"marked": "^18.0.5",
		"postgres": "^3.4.9",
		"posthog-js": "^1.398.0",
		"qrcode": "^1.5.4",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"workers-ai-provider": "^4.0.0",
		"zod": "^4.4.3"
	}
}
