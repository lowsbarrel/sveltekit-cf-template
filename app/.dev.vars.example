# Copied to .dev.vars automatically for local runs (.dev.vars is gitignored).
# For production: wrangler secret put BETTER_AUTH_SECRET (openssl rand -base64 32)
BETTER_AUTH_SECRET="dev-only-secret-not-for-production"

# Billing - Creem (Merchant of Record). Dashboard > Developers.
# A creem_test_ key selects Creem's test API host automatically; a live key selects production.
CREEM_API_KEY=creem_test_replace_me
CREEM_WEBHOOK_SECRET=whsec_replace_me

# Google OAuth. Console > Credentials > OAuth client (Web application).
# Authorized redirect URI: http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LOCAL ONLY. Logs the email body so magic-link and reset links are usable
# without a mail binding. Never set this as a production secret: those links
# are bearer credentials and anyone reading the logs could take an account.
EMAIL_DEBUG=true
